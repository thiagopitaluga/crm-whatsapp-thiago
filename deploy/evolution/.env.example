# Copy to .env on the VPS, fill in strong random values, then chmod 600 .env.
SERVER_URL=https://connect.tpxdigital.com/evolution
AUTHENTICATION_API_KEY=replace-with-at-least-32-random-bytes

POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=replace-with-a-strong-random-password
DATABASE_CONNECTION_URI=postgresql://evolution:replace-with-a-strong-random-password@evolution-postgres:5432/evolution?schema=public
