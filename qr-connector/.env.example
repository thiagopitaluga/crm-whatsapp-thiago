PORT=3001
AUTH_DIR=/app/data/auth
AUTH_ROOT=/app/data/sessions
CRM_BASE_URL=https://crm-whatsapp-thiago.vercel.app
# Use the same random value for both secrets. CONNECTOR_API_SECRET protects
# the session-management API; CRM_CONNECTOR_SECRET authenticates contact
# ingestion and keeps each company's contacts in its own CRM account.
CONNECTOR_API_SECRET=
CRM_CONNECTOR_SECRET=

# Legacy single-account fallback. New installations should leave this empty.
CRM_INGEST_API_KEY=
